doctype html 
html 
    head 
        title Persona 
        link(rel="stylesheet", href="/styles.css")
    body
    .dashboard-container

        include ../components/sidebar.pug
        
        main.content
            h1 Gestión de personal                
    
            main.container
                h1 Datos de #{persona.nombre} #{persona.apellido}

                .persona-detalle
                p #[strong ID:] #{persona.id}
                p #[strong Nombre:] #{persona.nombre}
                p #[strong Apellido:] #{persona.apellido}
                p #[strong Email:] #{persona.mail}
                p #[strong Sector:] #{persona.sector}
                p #[strong Rol:] #{persona.rol}

                .acciones-form
                    a.btn-editar(href=`/personas/${persona._id}/editar`) Editar
                    a.btn-eliminar(href=`/personas/${persona._id}/eliminar`) Eliminar
                    a.btn-cancelar(href='/personas') Cancelar