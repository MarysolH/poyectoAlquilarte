doctype html 
html 
    head 
        title Persona 
        link(rel="stylesheet", href="/styles.css")
    body
    .dashboard-container

        aside.sidebar
            h2 Alquilarte S.A.
            nav
                ul.nav-principal
                    li: a(href='/dashboard') Home
                    li: a(href='/propiedades') Gestión propiedades
                    li: a(href='/clientes') Gestión de clientes          
                    li: a(href='/contratos') Contratos
                    li: a(href='/pagos') Pagos
                    li: a(href='/mantenimiento') Mantenimiento
                    li: a(href='/personas') Gestión de personal
                    li: a(href='/reportes') Reportes
                    li: a(href='/logout') Cerrar sesión
        main.content
            h1 Gestión de personal                
    
            main.container
                h1 Datos de #{persona.nombre} #{persona.apellido}

                .persona-detalle
                p #[strong ID:] #{persona.id}
                p #[strong Nombre:] #{persona.nombre}
                p #[strong Apellido:] #{persona.apellido}
                p #[strong Email:] #{persona.mail}
                p #[strong Sector:] #{persona.sector}
                p #[strong Rol:] #{persona.rol}

                
                a.btn-editar(href=`/personas/${persona.id}/editar`) Editar
                a.btn-eliminar(href=`/personas/${persona.id}/eliminar`) Eliminar
                