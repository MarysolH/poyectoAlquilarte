doctype html
html
    head
        title Editar persona
        link(rel='stylesheet', href='/styles.css')
    body
    .dashboard-container

        include ../components/sidebar.pug
        
        main.content
            h1 Gestión de personal                
    
            section.container
                h1 Editar datos de #{persona.nombre} #{persona.apellido}

                form.formulario(action=`/personas/${persona._id}/editar` method="POST")
                    div(class="campo")
                        label(for="nombre") Nombre:
                        input(type="text" name="nombre" id="nombre" required value=persona.nombre)

                    div(class="campo")
                        label(for="apellido") Apellido:
                        input(type="text" name="apellido" id="apellido" required value=persona.apellido)

                    div(class="campo")
                        label(for="mail") Email:
                        input(type="email" name="mail" id="mail" required value=persona.mail)

                    div(class="campo")
                        label(for="sector") Sector:
                        input(type="text" name="sector" id="sector" required value=persona.sector)

                    div(class="campo")
                        label(for="rol") Rol:
                        input(type="text" name="rol" id="rol" required value=persona.rol)
                        
                    .acciones-form
                        button.btn-guardar(type="submit") Guardar cambios 
            

                    a.btn-cancelar(href='/personas') Cancelar