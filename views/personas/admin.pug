doctype html
html
  head
    title Panel de administración - Personas
    link(rel="stylesheet", href="/styles.css")

  body
  .dashboard-container

    include ../components/sidebar.pug
    

    main.content
      h1 Gestión de personal
      p Bienvenido/a #{usuario ? usuario.usuario : 'Invitado/a'}

      .cards
        .card
          h3 Area Contabilidad          

        .card
          h3 Area Administración          

        .card
          h3 Area Mantenimiento

        .card
          h3 Area Comercial  
          
      .acciones
        a(href='/personas/lista', class='btn-agregar') Agregar nueva persona

      table
        thead
          tr
            th ID
            th Nombre
            th Apellido
            th Email
            th Sector
            th Rol
            th Acciones
        tbody
          if personas.length > 0
            each persona in personas
              tr
                td #{persona.id}
                td #{persona.nombre}
                td #{persona.apellido}
                td #{persona.mail}
                td #{persona.sector}
                td #{persona.rol}
                td
                  a(href=`/personas/${persona._id}`, class='btn-ver') Ver
                  a(href=`/personas/${persona._id}/editar`, class='btn-editar') Editar
                  a(href=`/personas/${persona._id}/eliminar`, class='btn-eliminar') Eliminar
          else
            tr
              td(colspan='7') No hay personal registrado aún.

      