doctype html
html
    head
      title Agregar nueva persona
      link(rel='stylesheet', href='/styles.css')
    body
      aside.sidebar
        h2 Alquilarte S.A.
        nav
          ul.nav-principal
            li: a(href='/dashboard') Home
            li: a(href='/propiedades') Gestión propiedades
            li: a(href='/clientes') Gestión de clientes          
            li: a(href='/contratos') Contratos
            li: a(href='/pagos') Pagos
            li: a(href='/mantenimiento') Mantenimiento
            li: a(href='/personas') Gestión de personal
            li: a(href='/reportes') Reportes
            li: a(href='/logout') Cerrar sesión

      main.content
        main.container
          h1 Agregar nueva persona  
        
          form.formulario(action="/personas" method="POST")
            div.campo
              label(for="nombre") Nombre:
              input(type="text" name="nombre" id="nombre" required)

            div.campo
              label(for="apellido") Apellido:
              input(type="text" name="apellido" id="apellido" required)

            div.campo
              label(for="mail") Email:
              input(type="email" name="mail" id="mail" required)

            div.campo
              label(for="sector") Sector:
              input(type="text" name="sector" id="sector" required)

            div.campo
              label(for="rol") Rol:
              input(type="text" name="rol" id="rol" required)

            .acciones-form
              button.btn-guardar(type="submit") Agregar

            a.btn-cancelar(href='/personas') Cancelar