doctype html
html
  head
    title Panel principal - Alquilarte
    link(rel="stylesheet", href="/styles.css")
  
  body
  .dashboard-container
 
    aside.sidebar
      h2 Alquilarte S.A.
      nav
        ul.nav-principal
          li: a(href='/dashboard') Home
          li: a(href='/propiedades') Gestión propiedades
          li: a(href='/clientes') Gestión de clientes          
          li: a(href='/contratos') Contratos
          li: a(href='/pagos') Pagos
          li: a(href='/mantenimiento') Mantenimiento
          li: a(href='/personas') Gestión de personal
          li: a(href='/reportes') Reportes
          if usuario && usuario.nivelAcceso === 'Admin'
            li: a(href='/registro') Gestión de usuarios
          li: a(href='/logout') Cerrar sesión

    section.contenido-principal
      h1 Panel principal
      p Bienvenido/a #{usuario ? usuario.usuario : 'Invitado/a'}
      p Nivel de acceso: #{usuario.nivelAcceso}

      .cards
        a.card(href='/propiedades')
          h3 Total de propiedades
          p #{total}
        a.card(href='/propiedades/alquiladas')
          h3 Alquiladas
          p #{totalAlquiladas}
        a.card(href='/propiedades/reservadas')
          h3 Reservadas
          p #{totalReservadas}
        .card
          h3 Pagos pendientes
          p $24.500

      .tareas
        h2 Tareas pendientes
        table
          thead
            tr
              th Descripción
              th Responsable
              th Prioridad
              th Fecha
          tbody
            each tarea in tareasSimuladas
              tr
                td= tarea.descripcion
                td= tarea.responsable
                td= tarea.prioridad
                td= tarea.fecha

    section.ultimos-registros
      h2 Últimos registros

      .area
        h3 Propiedades 
        ul
          each propiedad in ultimasPropiedades
            li #{propiedad.tipo}: #{propiedad.direccion}

      .area
        h3 Clientes 
        ul
          each cliente in ultimosClientes
            li #{cliente.nombre} #{cliente.apellido} - #{cliente.tipo}

      .area
        h3 Personal 
        ul
          each persona in ultimasPersonas
            li #{persona.nombre} #{persona.apellido} - #{persona.rol}
    