doctype html
html
  head
    title Nuevo cliente
    link(rel='stylesheet', href='/styles.css')
  body
  .dashboard-container

    aside.sidebar
      h2 Alquilarte S.A.
      nav
        ul.nav-principal
          li: a(href='/dashboard') Home
          li: a(href='/propiedades') Gestión propiedades
          li: a(href='/clientes') Gestión de clientes          
          li: a(href='/contratos') Contratos
          li: a(href='/pagos') Pagos
          li: a(href='/mantenimiento') Mantenimiento
          li: a(href='/personas') Gestión de personal
          li: a(href='/reportes') Reportes
          li: a(href='/logout') Cerrar sesión          
    main.content
      h1 Gestión de clientes      
        
      section.container
        h1 Completar datos    

        form.formulario(action="/clientes/nuevo" method="POST")
          div(class="campo")
            label(for="nombre") Nombre:
            input(type="text", name="nombre", required)

          div(class="campo")
            label(for="apellido") Apellido:
            input(type="text", name="apellido", required) 

          div(class="campo")
            label(for="mail") Email:
            input(type="email", name="mail", required)

          div(class="campo")
            label(for="telefono") Teléfono:
            input(type="text", name="telefono", required)

          div(class="campo")
            label(for="tipo") Tipo:
            select(name="tipo", required)
              option(value="inquilino") Inquilino
              option(value="propietario") Propietario 

          .acciones-form
            button.btn-guardar(type="submit") Guardar datos

          a.btn-cancelar(href='/clientes') Cancelar