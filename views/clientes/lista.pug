doctype html
html
  head
    title Lista de clientes
    link(rel='stylesheet', href='/styles.css')
  body
    include ../header.pug

    h1 Lista de clientes

    a(href='/clientes/nuevo').btn-agregar Agregar nuevo cliente

    table
      thead
        tr
          th Nombre
          th Apellido
          th Email
          th Teléfono
          th Tipo
          th Acciones
      tbody
        each cliente in clientes
          tr
            td #{cliente.nombre}
            td #{cliente.apellido}            
            td #{cliente.mail}
            td #{cliente.telefono}
            td #{cliente.tipo}            
            td
              a(href=`/clientes/${cliente._id}/editar`) Editar
              a(href=`/clientes/${cliente._id}/eliminar`, class="btn-eliminar") Eliminar

    