doctype html
html
  head
    title Confirmar eliminación
    link(rel='stylesheet', href='/styles.css')
  body
      aside.sidebar
        h2 Alquilarte S.A.
        nav
          ul.nav-principal
            li: a(href='/dashboard') Home
            li: a(href='/propiedades') Gestión propiedades
            li: a(href='/clientes') Gestión de clientes          
            li: a(href='/contratos') Contratos
            li: a(href='/pagos') Pagos
            li: a(href='/mantenimiento') Mantenimiento
            li: a(href='/personas') Gestión de personal
            li: a(href='/reportes') Reportes
            li: a(href='/logout') Cerrar sesión

      main.content
        h1 Gestión de clientes

        section.container
          h1 ¿Seguro que deseas eliminar a #{cliente.nombre} #{cliente.apellido}?

          form(action=`/clientes/${cliente._id}/eliminar`, method="POST")
            button.btn-eliminar(type="submit", class="btn-eliminar") Sí, eliminar
            a.btn-cancelar(href='/clientes') Cancelar