doctype html
html
  head
    title Eliminar propiedad
    link(rel='stylesheet', href='/styles.css')
  body
  .dashboard-container

    include ../components/sidebar.pug
    

    main.content
      h1 Gestión de propiedades

      section.container
        h1 Eliminar propiedad
        p ¿Estás seguro que querés eliminar la siguiente propiedad?

        ul
          li Dirección: #{propiedad.direccion}
          li Tipo: #{propiedad.tipo}
          li Estado: #{propiedad.estado}
          li Precio: $#{propiedad.precio}
          if propiedad.propietario
            li Propietario: #{propiedad.propietario.nombre} #{propiedad.propietario.apellido}
          else
            li Propietario: No asignado

        form(action=`/propiedades/${propiedad._id}/eliminar` method='POST')
          button.btn-eliminar(type='submit') Confirmar eliminación
          a.btn-cancelar(href='/propiedades') Cancelar