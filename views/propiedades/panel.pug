doctype html
html
  head
    title Gestion de propiedades
    link(rel='stylesheet', href="/styles.css")
  
  body   
  .dashboard-container
 
    include ../components/sidebar.pug
    

    main.content
      h1 Gestión de propiedades
      p Bienvenido/a #{usuario ? usuario.usuario : 'Invitado/a'}

      .cards
        a.card(href='/propiedades')
          h3 Total de propiedades
          p #{total}

        a.card(href='/propiedades?filtro=alquiladas')
          h3 Alquiladas
          p #{totalAlquiladas}

        a.card(href='/propiedades?filtro=reservadas')
          h3 Reservadas
          p #{totalReservadas}

      .acciones
        a(href="/propiedades/nueva", class='btn-agregar') + Agregar propiedad

      if propiedades.length
        table
          thead
            tr
              th Dirección
              th Tipo
              th Estado
              th Precio
              th Acciones
          tbody
            each propiedad in propiedades
              tr
                td= propiedad.direccion
                td= propiedad.tipo
                td= propiedad.estado
                td $#{propiedad.precio}
                td
                  a.btn-detalle(href=`/propiedades/${propiedad._id}`) Ver
                  a.btn-editar(href=`/propiedades/${propiedad._id}/editar`) Editar
                  a.btn-eliminar(href=`/propiedades/${propiedad._id}/eliminar`) Eliminar
      else
        p No hay propiedades registradas.

