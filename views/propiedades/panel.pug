doctype html
html
  head
    title Gestion de propiedades
    link(rel='stylesheet', href="/styles.css")
  
  body   
  .dashboard-container
 
    aside.sidebar
      h2 Alquilarte S.A.
      nav
        ul.nav-principal
          li: a(href='/dashboard') Home
          li: a(href='/propiedades') Gestión propiedades
          li: a(href='/clientes') Gestión de clientes          
          li: a(href='/contratos') Contratos
          li: a(href='/pagos') Pagos
          li: a(href='/mantenimiento') Mantenimiento
          li: a(href='/personas') Gestión de personal
          li: a(href='/reportes') Reportes
          li: a(href='/logout') Cerrar sesión

    main.content
      h1 Gestión de propiedades
      p Bienvenido/a #{usuario ? usuario.nombre : 'Invitado/a'}

      .cards
        a.card(href='/propiedades')
          h3 Total de propiedades
          p #{total}

        a.card(href='/propiedades/alquiladas')
          h3 Alquiladas
          p #{totalAlquiladas}

        a.card(href='/propiedades/reservadas')
          h3 Reservadas
          p #{totalReservadas}

      .acciones
        a(href="/propiedades/nueva", class='btn-agregar') + Agregar propiedad

      if propiedades.length
        table
          thead
            tr
              th Dirección
              th Tipo
              th Estado
              th Precio
              th Acciones
          tbody
            each propiedad in propiedades
              tr
                td= propiedad.direccion
                td= propiedad.tipo
                td= propiedad.estado
                td $#{propiedad.precio}
                td
                  a.btn-detalle(href=`/propiedades/${propiedad._id}`) Ver
                  a.btn-editar(href=`/propiedades/${propiedad._id}/editar`) Editar
                  a.btn-eliminar(href=`/propiedades/${propiedad._id}/eliminar`) Eliminar
      else
        p No hay propiedades registradas.

