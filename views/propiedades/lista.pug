doctype html
html
  head
    title Lista de propiedades
    link(rel='stylesheet', href='/styles.css')
  body
    include ../header
    include ../components/sidebar.pug
    
    main.content
      h1 Lista de propiedades

      a.btn-agregar(href='/propiedades/nueva') + Nueva propiedad

      if propiedades.length
        table
          thead
            tr
              th Dirección
              th Tipo
              th Estado
              th Precio
              th Propietario
              th Acciones
          tbody
            each propiedad in propiedades
              tr
                td #{propiedad.direccion}
                td #{propiedad.tipo}
                td #{propiedad.estado}
                td $#{propiedad.precio}
                td 
                  if propiedad.propietario
                    | #{propiedad.propietario.nombre} #{propiedad.propietario.apellido}
                  else
                    | -
                td
                  a.btn-detalle(href=`/propiedades/${propiedad._id}`) Ver
                  button.btn-guardar(type='submit') Guardar cambios
                  a(href=`/propiedades/${propiedad._id}/eliminar`) Eliminar
      else
        p No hay propiedades registradas aún.